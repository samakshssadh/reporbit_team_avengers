{
  "name": "orbit-backend",
  "version": "1.0.0",
  "description": "Orbit backend: Node + PostgreSQL + Google Gemma; also serves the compiled Orbit frontend",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "node src/db/migrate.js",
    "seed": "node src/db/seed.js",
    "setup": "node src/db/migrate.js && node src/db/seed.js",
    "test": "node --test --test-concurrency=1 test/unit.test.js test/api.test.js",
    "build:frontend": "node scripts/build-frontend.js"
  },
  "dependencies": {
    "pg": "^8.13.0"
  },
  "license": "MIT"
}
