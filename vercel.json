{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "orbit-web": {
      "root": "backend",
      "framework": "node",
      "runtime": "node",
      "buildCommand": "npm install"
    },
    "frontend": {
      "root": "frontend",
      "framework": "vite"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "orbit-web"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}
