# Copy this file to .env and fill in real values. NEVER commit .env.
NODE_ENV=development
PORT=4000

# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/devpath

# Frontend origin allowed for CORS (only needed if you don't use a dev proxy)
CORS_ORIGIN=http://localhost:5173

# Set to true in production behind HTTPS
COOKIE_SECURE=false
SESSION_TTL_HOURS=720

# Optional: GitHub token (public read only, no scopes needed) raises rate limit 60 -> 5000 req/h
GITHUB_TOKEN=

# Google Gemma — Orbit AI LLM integration
# GEMMA_PROVIDER: 'google' (Google AI Studio hosted), 'ollama' (local inference), 'auto', or 'none' (disabled)
GEMMA_PROVIDER=google
# Exact Gemma model id:
# - For Google AI Studio: 'gemma-2-9b-it', 'gemma-2-27b-it', or 'gemma-3-27b-it'
# - For Ollama: 'gemma3:4b' or 'gemma2:2b'
GEMMA_MODEL=gemma-2-9b-it
OLLAMA_URL=http://localhost:11434
# Google AI Studio API Key (from https://aistudio.google.com/app/apikey)
# Note: GEMINI_API_KEY is also accepted
GOOGLE_API_KEY=
GEMMA_TIMEOUT_MS=45000

# Optional: "Connect GitHub" with real GitHub login (OAuth). Create an OAuth App at
# GitHub → Settings → Developer settings → OAuth Apps, callback URL = <PUBLIC_URL>/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Public URL of this site (e.g. http://localhost:4000 or https://your-app.onrender.com)
PUBLIC_URL=http://localhost:4000
