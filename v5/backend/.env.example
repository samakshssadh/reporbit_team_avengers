# Copy this file to .env and fill in real values. NEVER commit .env.
NODE_ENV=development
PORT=4000

# PostgreSQL connection string
DATABASE_URL=postgres://postgres:postgres@localhost:5432/devpath

# Frontend origin allowed for CORS (only needed if you don't use a dev proxy)
CORS_ORIGIN=http://localhost:5173

# Set to true in production behind HTTPS
COOKIE_SECURE=false
SESSION_TTL_HOURS=168

# Optional: GitHub token (public read only, no scopes needed) raises rate limit 60 -> 5000 req/h
GITHUB_TOKEN=

# Google Gemma — owned by the Gemma teammate.
# GEMMA_PROVIDER: none | ollama | google
GEMMA_PROVIDER=none
# Exact model id, e.g. Ollama tag "gemma3:4b" or Google AI Studio id "gemma-3-27b-it"
GEMMA_MODEL=
OLLAMA_URL=http://localhost:11434
GOOGLE_API_KEY=
GEMMA_TIMEOUT_MS=45000

# Optional: "Connect GitHub" with real GitHub login (OAuth). Create an OAuth App at
# GitHub → Settings → Developer settings → OAuth Apps, callback URL = <PUBLIC_URL>/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Public URL of this site (e.g. http://localhost:4000 or https://your-app.onrender.com)
PUBLIC_URL=http://localhost:4000
